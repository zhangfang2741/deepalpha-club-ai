# .env.example — deepalpha-club-ai 环境变量模板
# 复制此文件为 .env 并填写实际值：cp .env.example .env

# ===== 应用基础 =====
APP_ENV=development                          # 环境：development | staging | production
PROJECT_NAME="DeepAlpha Club AI"
VERSION=1.0.0
DEBUG=true

# 产业图谱：图谱为空时启动自动注入 NVIDIA 产业链种子数据（true | false）
SEED_SUPPLY_CHAIN_ON_STARTUP=true
# 启动时自动执行 alembic upgrade head（release 阶段迁移不可靠时的兜底，true | false）
RUN_DB_MIGRATIONS_ON_STARTUP=true

# ===== API 配置 =====
API_V1_STR=/api/v1
ALLOWED_ORIGINS="http://localhost:3000,https://deepalpha.club,https://www.deepalpha.club"   # 允许的跨域来源（逗号分隔）
CORS_ORIGINS="http://localhost:3000,https://deepalpha.club,https://www.deepalpha.club"      # 同上，供前端验证用

# ===== 数据库 PostgreSQL =====
# 方式一：显式设置（优先级最高）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=deepalpha_db
POSTGRES_USER=deepalpha
POSTGRES_PASSWORD=changeme
POSTGRES_SSL=false                           # 云数据库（如 Supabase）需设为 true；Railway 内网设 false
# 方式二：Railway 等平台自动注入 DATABASE_URL 或 PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE，
# 当 POSTGRES_HOST 未设置时自动从这些变量解析，无需额外配置。
POSTGRES_POOL_SIZE=10                        # 连接池大小
POSTGRES_MAX_OVERFLOW=20                     # 超出连接池时最大额外连接数

# ===== Redis / Valkey 缓存 =====
# 方式一：显式设置（优先级最高）
VALKEY_HOST=                                 # 留空则使用内存缓存；Upstash 填 xxx.upstash.io
VALKEY_PORT=6379
VALKEY_DB=0
VALKEY_PASSWORD=                             # Upstash Redis 密码
VALKEY_SSL=false                             # Upstash 必须设为 true
# 方式二：Railway 等平台自动注入 REDIS_URL 或 REDISHOST/REDISPORT/REDISPASSWORD，
# 当 VALKEY_HOST 为空时自动从这些变量解析，无需额外配置。
VALKEY_MAX_CONNECTIONS=10
CACHE_TTL_SECONDS=3600                       # 默认缓存过期时间（秒）

# ===== LLM 供应商 =====
LLM_PROVIDER=claude                          # openai | claude | minimax | gemini
DEFAULT_LLM_MODEL=claude-sonnet-4-5          # 默认使用的模型名称（需与供应商匹配）
DEFAULT_LLM_TEMPERATURE=0.2
MAX_TOKENS=4096
MAX_LLM_CALL_RETRIES=3
LLM_TOTAL_TIMEOUT=60

# 图谱抽取模式（FinReflectKG，arXiv:2508.17906）
# single_pass = 旧版供应链抽取；finreflect_single / finreflect_multi（抽取→规范化两遍） / finreflect_reflection = 论文本体（24 实体/29 关系，5 元组入 finkg_triples）
GRAPH_EXTRACTION_MODE=single_pass
GRAPH_REFLECTION_MAX_ITERS=2                 # finreflect_reflection 最大反思步数 n_max

# OpenAI（LLM_PROVIDER=openai 时使用）
OPENAI_API_KEY=

# Anthropic Claude（LLM_PROVIDER=claude 时使用）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=                          # 留空使用官方地址；接 MiniMax 填 https://api.minimaxi.com/anthropic
# 当 ANTHROPIC_BASE_URL 指向 MiniMax 时注册的模型 ID 列表（逗号分隔，名称取小写）。
# 例如把高速版与推理版并列，再用 SUPPLY_CHAIN_DISCOVER_MODEL / DEFAULT_LLM_MODEL 选择：
MINIMAX_CLAUDE_MODELS=MiniMax-M2.7

# MiniMax（LLM_PROVIDER=minimax 时使用）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
# WordLens 英文例句高清 TTS；Key 留空时自动复用 MINIMAX_API_KEY。
# 按优先级以逗号分隔；前一个额度耗尽或调用失败时自动尝试下一个。
MINIMAX_TTS_API_KEYS=
# 兼容旧的单 Key 配置；仅在 MINIMAX_TTS_API_KEYS 为空时使用。
MINIMAX_TTS_API_KEY=
MINIMAX_TTS_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_TTS_MODEL=speech-2.8-hd
# Key 因额度或鉴权问题熔断后的冷却时间，默认 30 分钟。
MINIMAX_TTS_KEY_COOLDOWN_SECONDS=1800
# 通用美式口音 / 经典英式口音
MINIMAX_TTS_VOICE_US=English_Trustworthy_Man
MINIMAX_TTS_VOICE_UK=English_Graceful_Lady

# Google Gemini（LLM_PROVIDER=gemini 时使用；也是拍照识别单词默认视觉模型的 key）
GOOGLE_API_KEY=

# ===== 拍照识别单词专用视觉模型（vocabulary/recognizer） =====
# 独立于 LLM_PROVIDER，默认用 Gemini Flash-Lite（多语言 OCR 强、秒级延迟、成本低）。
# 默认 gemini-flash-lite-latest：轻量档，识别质量与标准 Flash 一致但快 2~3 倍；用
# -latest 别名避免具体版本号被 Google 停用导致 404。想固定版本可用 gemini-3.5-flash-lite；
# 追求更高质量、不在意慢一点可用 gemini-3.5-flash。
# 换模型只改这几个变量：provider 可选 gemini | openai | claude，需配置对应 API key。
VOCAB_VISION_PROVIDER=gemini
VOCAB_VISION_MODEL=gemini-flash-lite-latest
VOCAB_VISION_MAX_TOKENS=4096
# 识别温度：0 追求可复现（同一张图每次识别结果尽量一致）。非 0 会带来采样随机性。
VOCAB_VISION_TEMPERATURE=0.0
# 丰富阶段（配音标/释义/例句）并发批数上限。词多的图值越大越快，撞限流就调小。
VOCAB_ENRICH_CONCURRENCY=8

# ===== 邮件发送（注册验证 + 找回密码验证码）=====
# 用阿里云邮件推送的 SMTP 接入。控制台：邮件推送 → 发信地址 → 设置 SMTP 密码。
# 发信域名需完成 DNS 验证（SPF/DKIM/MX），否则会被主流邮箱直接拒收。
# 留空则注册和找回密码接口返回 503，其余功能不受影响。
SMTP_HOST=smtpdm.aliyun.com                  # 国际站用 smtpdm-ap-southeast-1.aliyuncs.com
SMTP_PORT=80                                 # 465=隐式SSL；80/25=STARTTLS。Railway 等 PaaS 常封 465，用 80
SMTP_USER=                                   # 发信地址，如 noreply@mail.deepalpha.club
SMTP_PASSWORD=                               # 该发信地址的 SMTP 密码（不是阿里云账号密码）
SMTP_FROM_NAME=鹦鹉背单词
SMTP_TIMEOUT_SECONDS=15

# 邮箱验证码策略（注册验证 + 找回密码共用；旧的 PASSWORD_RESET_* 变量名仍兼容）
EMAIL_CODE_TTL=600                           # 验证码有效期（秒），注册与找回密码共用
EMAIL_CODE_RESEND_COOLDOWN=60                 # 两次发送之间的最短间隔（秒）
EMAIL_CODE_MAX_ATTEMPTS=5                     # 错误次数上限，达到后验证码立即作废

# ===== 短信验证码（手机号注册 / 找回密码）=====
# 阿里云「号码认证服务 PNVS」的短信认证服务，不是通用短信服务 dysmsapi。
# 免自建签名和模板审核，购买套餐包后用系统提供的签名模板即可发送；
# 验证码由阿里云生成、保管和核验，我们不接触明文。
# 留空则手机号相关接口返回 503，邮箱注册/登录完全不受影响。
ALIYUN_SMS_ACCESS_KEY_ID=                    # RAM 子账号的 AccessKey，只授予短信认证权限
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=                        # 控制台选定的系统签名
ALIYUN_SMS_TEMPLATE_CODE=                    # 控制台选定的系统模板 ID
ALIYUN_SMS_ENDPOINT=https://dypnsapi.aliyuncs.com/
ALIYUN_SMS_REGION=cn-hangzhou
SMS_TIMEOUT_SECONDS=10
DEFAULT_PHONE_COUNTRY_CODE=86                # 用户只填 11 位号码时按此补全为 E.164

# ===== JWT 认证 =====
JWT_SECRET_KEY=change-me-in-production       # 生产环境必须替换为随机长字符串（32位+）
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Langfuse 可观测性（可选）=====
LANGFUSE_TRACING_ENABLED=false               # 开启后需要填写下方密钥
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== 限流 =====
RATE_LIMIT_DEFAULT="200 per day,50 per hour"
RATE_LIMIT_CHAT="30 per minute"
RATE_LIMIT_CHAT_STREAM="20 per minute"
RATE_LIMIT_MESSAGES="50 per minute"
RATE_LIMIT_LOGIN="20 per minute"
RATE_LIMIT_REGISTER="10 per hour"
RATE_LIMIT_VOCABULARY_RECOGNIZE="20 per hour"
RATE_LIMIT_VOCABULARY_CHANGE_PASSWORD="10 per hour"

# ===== 日志 =====
LOG_LEVEL=DEBUG
LOG_FORMAT=console                           # console（本地开发）| json（生产）
LOG_DIR=logs

# ===== 会话功能 =====
SESSION_NAMING_ENABLED=true                  # 自动为会话生成名称
LONG_TERM_MEMORY_COLLECTION_NAME=longterm_memory
LONG_TERM_MEMORY_MODEL=claude-haiku-4-5      # 用于记忆提取的轻量模型

# ===== 评估（Eval）=====
EVALUATION_LLM=claude-sonnet-4-5
EVALUATION_API_KEY=                          # 默认使用 ANTHROPIC_API_KEY

# ===== 性能分析（DEBUG 模式）=====
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0

# ===== Financial Modeling Prep API =====
# 免费版每日限额 250 次请求（https://financialmodelingprep.com）
FMP_API_KEY=

# ===== Alpha Vantage API =====
# 免费注册：https://www.alphavantage.co/support/#api-key
# 用于电话会议记录抓取（EARNINGS_CALL_TRANSCRIPT），不设置则用 demo key（限速）
ALPHA_VANTAGE_KEY=

# ===== 网络代理 =====
# 在国内环境下抓取 Yahoo Finance (yfinance) 或 CNN 数据可能需要代理
HTTP_PROXY=
HTTPS_PROXY=
# Company-centric supply-chain graph
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_SSL=false
SUPPLY_CHAIN_WORKER_CONCURRENCY=4
SUPPLY_CHAIN_UNIVERSE=sp500
# 单服务部署时 web 容器内是否一并后台运行 Celery worker（消费上面的队列）。
# 若单独部署了 worker 服务，可设为 false 只跑 web。
RUN_SUPPLY_CHAIN_WORKER=true
SUPPLY_CHAIN_VERIFY_THRESHOLD=60
SUPPLY_CHAIN_GENERIC_SUPPLIERS=TSMC,Samsung,Intel,Google Cloud,AWS
SUPPLY_CHAIN_SMALLCAP_MARKETCAP=2e9
SUPPLY_CHAIN_SKIP_RECENT_DAYS=7
SUPPLY_CHAIN_DISCOVER_MODEL=
SUPPLY_CHAIN_VERIFY_MODEL=
SUPPLY_CHAIN_BEAT_ENABLED=false
SUPPLY_CHAIN_DISCOVER_CACHE_TTL=604800
SUPPLY_CHAIN_TRANSCRIPT_QUARTERS=4
SUPPLY_CHAIN_NEWS_LOOKBACK_DAYS=730
SUPPLY_CHAIN_QUOTA_WINDOW_SECONDS=18000
SUPPLY_CHAIN_MAX_QUOTA_RETRIES=10
SUPPLY_CHAIN_MAX_PROBE_ATTEMPTS=10
SUPPLY_CHAIN_PROBE_BACKOFF_SECONDS=60

# Sign in with Apple（iOS App 的 Bundle ID，用作校验 Apple 身份令牌的 aud）
APPLE_CLIENT_ID=club.deepalpha.chan
